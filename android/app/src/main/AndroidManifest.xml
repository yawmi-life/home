<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="@string/app_name"
        android:icon="@drawable/yawmi_icon"
        android:roundIcon="@drawable/yawmi_icon"
        android:supportsRtl="true"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:theme="@android:style/Theme.Translucent.NoTitleBar">

        <meta-data android:name="asset_statements"
                   android:resource="@string/asset_statements" />

        <activity
            android:name="com.google.androidbrowserhelper.trusted.LauncherActivity"
            android:exported="true"
            android:label="@string/app_name">

            <meta-data
                android:name="android.support.customtabs.trusted.DEFAULT_URL"
                android:value="https://yawmi-life.github.io/home/index.html?source=apk" />
            <meta-data
                android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR"
                android:resource="@color/yawmi_theme" />
            <meta-data
                android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR"
                android:resource="@color/yawmi_background" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="yawmi-life.github.io"
                    android:pathPrefix="/home/" />
            </intent-filter>
        </activity>
        <receiver
            android:name="com.yawmilife.app.YawmiShortcutWidget"
            android:exported="true"
            android:label="@string/yawmi_widget_desc">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/yawmi_widget_info" />
        </receiver>
        <receiver
            android:name="com.yawmilife.app.YawmiCategoryWidget$Today"
            android:exported="true"
            android:label="@string/yawmi_widget_today">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/yawmi_category_widget_info" />
        </receiver>
        <receiver
            android:name="com.yawmilife.app.YawmiCategoryWidget$Productivity"
            android:exported="true"
            android:label="@string/yawmi_widget_productivity">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/yawmi_category_widget_info" />
        </receiver>
        <receiver
            android:name="com.yawmilife.app.YawmiCategoryWidget$Planning"
            android:exported="true"
            android:label="@string/yawmi_widget_planning">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/yawmi_category_widget_info" />
        </receiver>
        <receiver
            android:name="com.yawmilife.app.YawmiCategoryWidget$Learning"
            android:exported="true"
            android:label="@string/yawmi_widget_learning">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/yawmi_category_widget_info" />
        </receiver>
        <receiver
            android:name="com.yawmilife.app.YawmiCategoryWidget$Wellbeing"
            android:exported="true"
            android:label="@string/yawmi_widget_wellbeing">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/yawmi_category_widget_info" />
        </receiver>
        <receiver
            android:name="com.yawmilife.app.YawmiCategoryWidget$Life"
            android:exported="true"
            android:label="@string/yawmi_widget_life">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/yawmi_category_widget_info" />
        </receiver>
    </application>
</manifest>
