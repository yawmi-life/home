<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:layoutDirection="rtl"
    android:padding="14dp" android:background="@drawable/yawmi_widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layoutDirection="rtl" android:gravity="center_vertical">
        <TextView android:id="@+id/yw_title" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="wrap_content"
            android:textSize="18sp" android:textColor="#FFFFFF" android:textStyle="bold"
            android:gravity="right" android:clickable="true" android:maxLines="1"
            android:ellipsize="end" android:contentDescription="فتح يومي"/>
        <TextView android:id="@+id/yw_refresh" android:layout_width="38dp"
            android:layout_height="36dp" android:text="↻" android:textSize="23sp"
            android:gravity="center" android:background="@drawable/yawmi_widget_button"
            android:textColor="#FFFFFF" android:clickable="true"
            android:contentDescription="تحديث ويدجت يومي"/>
    </LinearLayout>
    <TextView android:id="@+id/yw_subtitle" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="11sp"
        android:textColor="#DBD2F5" android:paddingBottom="5dp" android:gravity="right"/>
    <TextView android:id="@+id/yw_metric_primary" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="22sp"
        android:textColor="#FFFFFF" android:textStyle="bold" android:gravity="right"
        android:maxLines="1" android:ellipsize="end" android:paddingTop="4dp"/>
    <TextView android:id="@+id/yw_metric_secondary" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="11sp"
        android:textColor="#E7DFFA" android:gravity="right" android:maxLines="2"
        android:paddingBottom="6dp"/>
    <ProgressBar android:id="@+id/yw_progress" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="7dp"
        android:max="100" android:progress="0" android:progressTint="#C7ABFF"
        android:progressBackgroundTint="#5A5077"/>
    <TextView android:id="@+id/yw_updated" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="9sp"
        android:textColor="#C7B5F6" android:gravity="right"
        android:paddingTop="5dp" android:paddingBottom="9dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="horizontal"
        android:layoutDirection="rtl">
        <TextView android:id="@+id/yw_button_1" style="@style/YawmiWidgetShortcut"/>
        <TextView android:id="@+id/yw_button_2" style="@style/YawmiWidgetShortcut"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layoutDirection="rtl"
        android:orientation="horizontal" android:layout_marginTop="7dp">
        <TextView android:id="@+id/yw_button_3" style="@style/YawmiWidgetShortcut"/>
        <TextView android:id="@+id/yw_button_4" style="@style/YawmiWidgetShortcut"/>
    </LinearLayout>
</LinearLayout>