<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:layoutDirection="rtl"
    android:padding="15dp" android:background="@drawable/yawmi_widget_background">
    <TextView android:id="@+id/yw_title" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="19sp"
        android:textColor="#FFFFFF" android:textStyle="bold"
        android:gravity="right" android:clickable="true"/>
    <TextView android:id="@+id/yw_subtitle" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="11sp"
        android:textColor="#DFD6FB" android:paddingTop="3dp"
        android:paddingBottom="10dp" android:gravity="right"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="horizontal"
        android:layoutDirection="rtl">
        <TextView android:id="@+id/yw_button_1" style="@style/YawmiWidgetShortcut"/>
        <TextView android:id="@+id/yw_button_2" style="@style/YawmiWidgetShortcut"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layoutDirection="rtl"
        android:orientation="horizontal" android:layout_marginTop="7dp">
        <TextView android:id="@+id/yw_button_3" style="@style/YawmiWidgetShortcut"/>
        <TextView android:id="@+id/yw_button_4" style="@style/YawmiWidgetShortcut"/>
    </LinearLayout>
</LinearLayout>